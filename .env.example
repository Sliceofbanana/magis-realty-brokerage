# ── Phase 1: Database ──────────────────────────────────────────────────────
# Local dev: `docker compose up -d` starts Postgres, matching this default.
DATABASE_URL="postgresql://magis:magis_dev_password@localhost:5432/magis_dev?schema=public"

# Staging/prod (Neon or Supabase) will replace the line above. Note: Prisma 7
# removed `directUrl`, so with a PgBouncer-style pooler (e.g. Supabase's
# 6543 transaction-mode pooler) you'll need the *direct* (5432/session-mode)
# connection string here specifically when running `prisma migrate` —
# something to solve when we actually deploy, not before.

# ── Phase 2: Auth.js ────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate your own: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-your-own-generated-secret"

# ── Phase 4: Cloudinary (media) ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── Phase 4: Upstash Redis (rate limiting / caching) ───────────────────────
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ── Phase 4: Resend (transactional email) ──────────────────────────────────
RESEND_API_KEY="re_your_resend_api_key"

# ── Optional ────────────────────────────────────────────────────────────────
# Sender shown on outgoing email (must be a domain verified in Resend).
RESEND_FROM_EMAIL="Magis Realty & Brokerage <noreply@your-domain.example>"
# Cloudflare Turnstile on public forms; leave blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Set to 1 ONLY if your own reverse proxy overwrites X-Forwarded-For (Vercel is trusted automatically).
TRUST_PROXY=""
